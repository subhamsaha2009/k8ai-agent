# .env is only needed if you skip 'k8ai init' and want to set config manually.
# After running 'k8ai init', config is stored in ~/.k8ai/ and the API key in your OS keychain.
#
# If you prefer .env, copy this file to .env and fill in your values.
# Never commit .env to GitHub.

AI_PROVIDER=azure        # azure | openai | claude
AI_API_KEY=              # your API key for the chosen provider
AI_MODEL=gpt-4o          # model or deployment name

# Azure only — leave blank or remove if using openai or claude
AI_ENDPOINT=https://<your-resource>.openai.azure.com/
AI_API_VERSION=2024-10-21

# ── Examples ──────────────────────────────────────────────────────────────────
#
# Azure OpenAI:
#   AI_PROVIDER=azure
#   AI_API_KEY=<azure-api-key>
#   AI_MODEL=gpt-4o
#   AI_ENDPOINT=https://<resource>.openai.azure.com/
#   AI_API_VERSION=2024-10-21
#
# OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o
#
# Anthropic Claude:
#   AI_PROVIDER=claude
#   AI_API_KEY=sk-ant-...
#   AI_MODEL=claude-opus-4-6
